# コピーして .env を作り、各サイトのログイン情報を入れる:
#     Windows:      copy .env.example .env
#     mac / Linux:  cp .env.example .env
#
# setup.bat を実行した場合は自動でコピー済み。
# メモ帳で編集して保存するときは、文字コードを UTF-8 にすること
# （BOM が付いても読めるようにしてあるが、Shift_JIS だと読めない）。
#
# .env は .gitignore 済み。絶対にコミットしないこと。
# 変数名は sites/*.yaml の credentials.*_env と一致させる。

BIZREACH_CAMPUS_EMAIL=
BIZREACH_CAMPUS_PASSWORD=

GAISHISHUKATSU_EMAIL=
GAISHISHUKATSU_PASSWORD=

TYPE_SHUKATSU_EMAIL=
TYPE_SHUKATSU_PASSWORD=
