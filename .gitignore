# ---- 認証情報（絶対にコミットしない） ----
.env
config.yaml
service_account.json
credentials.json
token.json

# oauth_client.json は「Google でログイン」を配るために *あえてコミットする*。
# デスクトップアプリの client_secret を Google 自身が機密として扱わない前提の
# 運用だが、公開したくない場合はここのコメントを外し、友人には手渡しすること。
# oauth_client.json
.sessions/
*.pem
*-key.json

# ---- 実行結果・個人情報を含みうるもの ----
*.log
*.ics
debug_*.png
inspect_*.txt

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---- OS ----
.DS_Store
